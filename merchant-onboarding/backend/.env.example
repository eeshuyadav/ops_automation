# Local Postgres connection. Change user/password/host/port/dbname to match
# your local setup. Create the DB first:  createdb merchant_onboarding
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchant_onboarding

# Same connection in sync form for the poller (no +asyncpg suffix).
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merchant_onboarding

# Where the frontend is served (for CORS).
FRONTEND_URL=http://localhost:5173

# Shared secret required on the `X-API-Key` header for every endpoint
# except /api/health. Leave empty for local dev (the server will log a
# warning) — set to a long random string in production.
API_KEY=change-me-to-a-real-secret

# Submerchant rows with Gokwik KYC complete date <= this cutoff are NOT
# seeded into the dashboard (assumed already present from the one-time
# backfill of the Easebuzz tab). ISO date.
KYC_SEED_CUTOFF=2026-05-05

# Slack — read-only bot token for the channel where the bot posts
# salt & key receipt notifications. Used by the poller to fill in the
# `salt_key_receipt` column. Scopes required: channels:history, channels:read.
# Bot must be /invite'd into the channel for history calls to return data.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SALT_KEY_CHANNEL_ID=C0ALVC72T6K
# Backstop: how far back to look during a normal hourly run, in days.
# (Backfill mode ignores this and walks the entire channel history.)
SLACK_LOOKBACK_DAYS=14
